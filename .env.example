# ──── Database ────────────────────────────────────────────────
POSTGRES_DB=cybersec
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://cybersec:changeme@db:5432/cybersec

# ──── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──── JWT Auth ────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ──── AI (Claude API for RCA recommendations) ─────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ──── Scan Tools (optional — for real integrations) ───────────
# NMAP_PATH=/usr/bin/nmap
# ZAP_API_KEY=your-zap-api-key
# ZAP_BASE_URL=http://localhost:8080
# YARA_RULES_DIR=/app/yara_rules

# ──── App Config ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
REPORTS_DIR=/app/reports
SCAN_RESULTS_DIR=/app/scan_results
